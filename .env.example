# Flask Configuration
FLASK_DEBUG=False
PORT=5000

# ── Authentication Mode ──────────────────────────────────────────────
# "key"               → classic Azure OpenAI API-key auth
# "service_principal" → Azure AD / Entra ID (service principal) auth
AZURE_AUTH_MODE=key

# ── Option A: API Key Authentication (AZURE_AUTH_MODE=key) ───────────
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_api_key_here
AZURE_OPENAI_DEPLOYMENT=your_deployment_name_here

# ── Option B: Service Principal Authentication (AZURE_AUTH_MODE=service_principal) ──
# Provide the service principal the "Cognitive Services Data Contributor (Preview)"
# role on the Azure AI Foundry resource.
# FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
# AZURE_OPENAI_DEPLOYMENT=your_deployment_name_here
AZURE_APP_REGISTRATION_NAME=app_name_here
# AZURE_CLIENT_ID=your_client_id_here
# AZURE_TENANT_ID=your_tenant_id_here
# AZURE_CLIENT_SECRET="your_client_secret_here"
# Token scope: https://ai.azure.com/.default for Foundry, https://cognitiveservices.azure.com/.default for classic
# AZURE_TOKEN_SCOPE=https://ai.azure.com/.default

# Azure OpenAI Realtime API Configuration (for voice conversations)
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime
AZURE_OPENAI_REALTIME_API_VERSION=2024-10-01-preview

# Native MCP Server Configuration (optional)
# Set USE_NATIVE_MCP=true to let the Realtime API call MCP servers directly
# This requires MCP servers to be running as HTTP services with accessible URLs

#Run MCP servers locally for testing:
# cd c:\Git\Pokedex\Pokedex\poke-mcp
# node dist/index.js --http --port=3001

# cd c:\Git\Pokedex\Pokedex\ptcg-mcp
# node dist/index.js --http --port=3002

# Optional: Pokemon API Configuration
POKEMON_API_URL=https://pokeapi.co/api/v2

# Optional: Pokemon TCG API key (https://docs.pokemontcg.io/getting-started/authentication)
POKEMON_TCG_API_KEY=your_api_key_here

# Pokemon TCG Gallery - define how many cards to fetch from api (max 250)
TCG_PAGE_SIZE=250

# Simple Authentication for accessing the apis that is used in this demo
APP_API_PASSWORD=SomePassword
